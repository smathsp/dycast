{
  "name": "dycast",
  "version": "26.9.15",
  "description": "抖音弹幕姬 - 实时弹幕互动 Happy 系统",
  "author": "SKMCJ",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.cjs",
    "check:electron": "node --check main.cjs && node --check preload.cjs && node --check server.cjs && node --check ai-curation.cjs && node --check persistent-settings.cjs && node --check remote-image-url.cjs && node --check renderer-recovery-policy.cjs && node --check response-body.cjs && node --check safe-zip.cjs && node --check trusted-renderer-url.cjs && node --check window-layout.cjs && node --check xlsx.cjs && node -e \"require('./xlsx.cjs')\" && node --check scripts/clean.cjs",
    "check": "npm run check:electron && npm run test && npm run type-check && npm run build-only",
    "clean": "node scripts/clean.cjs",
    "clean:all": "node scripts/clean.cjs --all",
    "electron:dev": "npm run build && electron .",
    "electron:package": "electron-builder --win portable --x64",
    "electron:build": "npm run clean && npm run build && npm run electron:package",
    "electron:build:dir": "npm run clean && npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.dycast.app",
    "productName": "抖音弹幕姬",
    "directories": {
      "output": "build/release"
    },
    "artifactName": "${productName} ${version}-完全优化-免安装版.${ext}",
    "files": [
      "main.cjs",
      "ai-curation.cjs",
      "persistent-settings.cjs",
      "remote-image-url.cjs",
      "renderer-recovery-policy.cjs",
      "response-body.cjs",
      "safe-zip.cjs",
      "preload.cjs",
      "server.cjs",
      "trusted-renderer-url.cjs",
      "window-layout.cjs",
      "xlsx.cjs",
      "build/renderer/**/*"
    ],
    "win": {
      "icon": "resources/app-icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronLanguages": [
      "zh-CN"
    ],
    "compression": "maximum",
    "asar": true
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@types/pako": "^2.0.3",
    "@types/vue-virtual-scroller": "npm:@earltp/vue-virtual-scroller@^1.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "lxgw-wenkai-webfont": "^1.7.0",
    "npm-run-all2": "^7.0.2",
    "pako": "^2.1.0",
    "sass": "^1.87.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8",
    "vue-virtual-scroller": "2.0.0-beta.8"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23"
  }
}
